# Salin menjadi .env.local lalu isi dari Firebase Console > Project settings > Your apps > Web.
# Nilai ini identitas proyek, bukan rahasia. Rahasia (kunci Xendit, client secret) TIDAK pernah ditaruh di sini.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = pakai Firebase Emulator (projectId demo-taskflow). Biarkan true selama pengembangan.
VITE_USE_EMULATORS=true
