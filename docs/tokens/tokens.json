{
  "$description": "TaskFlow design tokens v0.3 — format W3C Design Tokens (DTCG). Sumber kebenaran; tokens.css dan tailwind.preset.js diturunkan dari file ini.",
  "color": {
    "$type": "color",
    "light": {
      "canvas":   { "$value": "#e4e2dc", "$description": "Latar di luar layar aplikasi (prototipe)" },
      "bg":       { "$value": "#f6f5f1", "$description": "Latar halaman" },
      "surface":  { "$value": "#fdfcfa", "$description": "Kartu, sidebar, sheet, navigasi bawah" },
      "surface2": { "$value": "#eeece6", "$description": "Segmented control, kolom Board, track progress" },
      "hover":    { "$value": "#1c1b180b", "$description": "rgba(28,27,24,.045)" },
      "line":     { "$value": "#1c1b1814", "$description": "rgba(28,27,24,.08) — pemisah, border kartu" },
      "line2":    { "$value": "#1c1b1829", "$description": "rgba(28,27,24,.16) — border tombol sekunder dan chip" },
      "fg":       { "$value": "#1c1b18", "$description": "Teks utama · 16,8:1 di surface" },
      "fg2":      { "$value": "#58554e", "$description": "Teks sekunder · 7,25:1" },
      "fg3":      { "$value": "#6b675f", "$description": "Teks tersier (paling redup yang diizinkan) · 5,49:1" },
      "accent":      { "$value": "#355bbd", "$description": "oklch(0.5 0.16 265) · 6,05:1 di surface", "$extensions": { "oklch": "oklch(0.5 0.16 265)" } },
      "accent-soft": { "$value": "#355bbd1c", "$description": "accent alpha .11" },
      "on-accent":   { "$value": "#ffffff" },
      "high":      { "$value": "#c22826", "$description": "Prioritas Tinggi, terlambat, hapus · 4,75:1 di high-soft", "$extensions": { "oklch": "oklch(0.53 0.19 27)" } },
      "high-soft": { "$value": "#c228261c" },
      "med":       { "$value": "#915200", "$description": "Prioritas Sedang · 4,6:1 di med-soft", "$extensions": { "oklch": "oklch(0.5 0.12 65)" } },
      "med-soft":  { "$value": "#d0901e2e", "$description": "oklch(0.7 0.14 75 / .18)" },
      "low":       { "$value": "#296b88", "$description": "Prioritas Rendah · 4,9:1 di low-soft", "$extensions": { "oklch": "oklch(0.5 0.08 230)" } },
      "low-soft":  { "$value": "#296b881f" },
      "area-kuliah":  { "$value": "#347ec4", "$description": "Penanda saja, bukan teks", "$extensions": { "oklch": "oklch(0.58 0.13 250)" } },
      "area-kantor":  { "$value": "#915db4", "$description": "Penanda saja, bukan teks", "$extensions": { "oklch": "oklch(0.57 0.14 310)" } },
      "area-pribadi": { "$value": "#389560", "$description": "Penanda saja, bukan teks", "$extensions": { "oklch": "oklch(0.6 0.12 155)" } }
    },
    "dark": {
      "canvas":   { "$value": "#0d0d0c" },
      "bg":       { "$value": "#161614" },
      "surface":  { "$value": "#1e1d1b" },
      "surface2": { "$value": "#282724" },
      "hover":    { "$value": "#fffaf00b", "$description": "rgba(255,250,240,.045)" },
      "line":     { "$value": "#fffaf014", "$description": "rgba(255,250,240,.08)" },
      "line2":    { "$value": "#fffaf026", "$description": "rgba(255,250,240,.15)" },
      "fg":       { "$value": "#efede7" },
      "fg2":      { "$value": "#aaa69d", "$description": "6,94:1 di surface" },
      "fg3":      { "$value": "#9a968d", "$description": "5,71:1 di surface" },
      "accent":      { "$value": "#7ca2f6", "$extensions": { "oklch": "oklch(0.72 0.13 265)" } },
      "accent-soft": { "$value": "#7ca2f624", "$description": "accent alpha .14" },
      "on-accent":   { "$value": "#111111" },
      "high":      { "$value": "#f27166", "$extensions": { "oklch": "oklch(0.7 0.16 27)" } },
      "high-soft": { "$value": "#f2716624" },
      "med":       { "$value": "#e8aa4e", "$extensions": { "oklch": "oklch(0.78 0.13 75)" } },
      "med-soft":  { "$value": "#e8aa4e21" },
      "low":       { "$value": "#76adc8", "$extensions": { "oklch": "oklch(0.72 0.07 230)" } },
      "low-soft":  { "$value": "#76adc821" },
      "area-kuliah":  { "$value": "#61a3e6", "$extensions": { "oklch": "oklch(0.7 0.12 250)" } },
      "area-kantor":  { "$value": "#b589d6", "$extensions": { "oklch": "oklch(0.7 0.12 310)" } },
      "area-pribadi": { "$value": "#68b986", "$extensions": { "oklch": "oklch(0.72 0.11 155)" } }
    },
    "accent-theme": {
      "$description": "Warna aksen pilihan (fitur Pro). Kunci = nama tema. Light/dark masing-masing.",
      "indigo":    { "light": { "$value": "#355bbd", "$extensions": { "oklch": "oklch(0.5 0.16 265)" } },  "dark": { "$value": "#7ca2f6", "$extensions": { "oklch": "oklch(0.72 0.13 265)" } } },
      "teal":      { "light": { "$value": "#007376", "$description": "Lightness diturunkan ke 0.47 agar lolos 4,5:1", "$extensions": { "oklch": "oklch(0.47 0.16 195)" } }, "dark": { "$value": "#00bdbe", "$extensions": { "oklch": "oklch(0.72 0.13 195)" } } },
      "tangerine": { "light": { "$value": "#a83a00", "$extensions": { "oklch": "oklch(0.5 0.16 45)" } },   "dark": { "$value": "#e7885d", "$extensions": { "oklch": "oklch(0.72 0.13 45)" } } },
      "forest":    { "light": { "$value": "#007b2a", "$extensions": { "oklch": "oklch(0.5 0.16 150)" } },  "dark": { "$value": "#62bb78", "$extensions": { "oklch": "oklch(0.72 0.13 150)" } } }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Bricolage Grotesque", "system-ui", "sans-serif"] },
      "sans":    { "$value": ["Onest", "system-ui", "sans-serif"] },
      "mono":    { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium":  { "$value": 500 },
      "semibold":{ "$value": 600 },
      "bold":    { "$value": 700 }
    }
  },
  "typography": {
    "$type": "typography",
    "title-xl":   { "$value": { "fontFamily": "{font.family.display}", "fontSize": "34px", "fontWeight": 600, "lineHeight": 1.05, "letterSpacing": "-0.02em" }, "$description": "Judul halaman desktop. HP: 32px" },
    "title-l":    { "$value": { "fontFamily": "{font.family.display}", "fontSize": "30px", "fontWeight": 600, "lineHeight": 1.05, "letterSpacing": "-0.02em" }, "$description": "Nama proyek di detail, nama bulan/minggu" },
    "title-m":    { "$value": { "fontFamily": "{font.family.display}", "fontSize": "20px", "fontWeight": 600, "lineHeight": 1.25, "letterSpacing": "0" }, "$description": "Judul tugas di detail, nama proyek di kartu (16–18px)" },
    "body":       { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.3, "letterSpacing": "0" }, "$description": "Judul tugas di daftar" },
    "body-s":     { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13px", "fontWeight": 500, "lineHeight": 1.45, "letterSpacing": "0" }, "$description": "Keterangan, tombol kecil" },
    "meta":       { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.35, "letterSpacing": "0" }, "$description": "Nama proyek di bawah tugas, sisa hari" },
    "label":      { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "11px", "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": "0.08em" }, "$description": "Label bagian, huruf kapital" },
    "badge":      { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "10.5px", "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": "0.02em" }, "$description": "Prioritas. Batas bawah teks: 10px" }
  },
  "space": {
    "$type": "dimension",
    "0":  { "$value": "0px" },
    "1":  { "$value": "2px" },
    "2":  { "$value": "4px" },
    "3":  { "$value": "6px" },
    "4":  { "$value": "8px" },
    "5":  { "$value": "10px" },
    "6":  { "$value": "12px" },
    "7":  { "$value": "14px" },
    "8":  { "$value": "16px" },
    "10": { "$value": "20px" },
    "12": { "$value": "24px" },
    "14": { "$value": "28px" },
    "16": { "$value": "32px" },
    "22": { "$value": "44px" }
  },
  "radius": {
    "$type": "dimension",
    "xs":    { "$value": "5px",  "$description": "Badge kecil, chip kalender" },
    "sm":    { "$value": "7px",  "$description": "Tombol di segmented control" },
    "md":    { "$value": "10px", "$description": "Tombol, input, baris tugas" },
    "lg":    { "$value": "14px", "$description": "Kartu desktop" },
    "xl":    { "$value": "16px", "$description": "Kartu HP" },
    "fab":   { "$value": "20px" },
    "sheet": { "$value": "22px", "$description": "Sudut atas bottom sheet" },
    "pill":  { "$value": "99px" }
  },
  "shadow": {
    "$type": "shadow",
    "seg-active": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#0000001a" } },
    "fab":        { "$value": { "offsetX": "0px", "offsetY": "10px", "blur": "24px", "spread": "-8px", "color": "#1e3f978c" }, "$description": "Warna = aksen gelap alpha .55" },
    "frame":      { "$value": [
      { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#1c1b180d" },
      { "offsetX": "0px", "offsetY": "24px", "blur": "60px", "spread": "-20px", "color": "#1c1b1840" }
    ], "$description": "Bingkai layar prototipe saja" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast":  { "$value": "150ms", "$description": "Hover, centang" },
      "base":  { "$value": "200ms", "$description": "Fade overlay, ganti tema, slide panel" },
      "sheet": { "$value": "280ms", "$description": "Bottom sheet naik" },
      "bar":   { "$value": "300ms", "$description": "Lebar progress bar" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.25, 0.1, 0.25, 1] },
      "sheet":    { "$value": [0.2, 0.8, 0.2, 1] }
    }
  },
  "size": {
    "$type": "dimension",
    "touch-min":      { "$value": "36px", "$description": "Area sentuh minimum di HP" },
    "button-mobile":  { "$value": "48px", "$description": "Tombol utama di HP" },
    "task-row":       { "$value": "50px" },
    "checkbox":       { "$value": "20px", "$description": "Lingkaran centang; area sentuh 38px" },
    "nav-bottom":     { "$value": "88px" },
    "nav-pill-w":     { "$value": "56px" },
    "nav-pill-h":     { "$value": "30px" },
    "fab":            { "$value": "58px" },
    "sidebar":        { "$value": "236px" },
    "detail-panel":   { "$value": "360px" },
    "content-narrow": { "$value": "780px", "$description": "Hari Ini, Inbox" },
    "content-wide":   { "$value": "900px", "$description": "Proyek" },
    "week-hour":      { "$value": "48px", "$description": "Tinggi 1 jam di tampilan Mingguan" },
    "week-gutter":    { "$value": "56px" },
    "icon-sidebar":   { "$value": "16px" },
    "icon-nav":       { "$value": "22px" }
  },
  "z": {
    "$type": "number",
    "row":     { "$value": 1 },
    "sticky":  { "$value": 3 },
    "nav":     { "$value": 4 },
    "overlay": { "$value": 8 },
    "sheet":   { "$value": 9 },
    "toast":   { "$value": 50 }
  }
}
