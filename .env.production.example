# Salin file ini menjadi .env.production.local sebelum menjalankan `npm run build` untuk produksi.
# Isi nilainya dari Firebase Console > Project settings > Your apps > Web (taskflow-228ee).
# Nilai ini identitas aplikasi web Firebase, bukan rahasia. File .env.production.local tidak ikut commit (.gitignore).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# WAJIB false untuk build produksi supaya aplikasi tidak mencoba menyambung ke emulator lokal.
VITE_USE_EMULATORS=false
